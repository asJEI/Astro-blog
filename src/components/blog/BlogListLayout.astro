---
import type { BlogPost } from "../../lib/blog";

import "../../styles/global.css";

import Navbar from "../layout/Navbar.astro";
import RightAside from "../layout/RightAside.astro";
import Sidebar from "../layout/Sidebar.astro";
import SiteFooter from "../layout/SiteFooter.astro";
import SiteHead from "../layout/SiteHead.astro";

interface Props {
  posts: BlogPost[];
  title: string;
  eyebrow: string;
  description: string;
  pageTitle?: string;
}

const { posts, title, eyebrow, description, pageTitle = `${title} | 北海` } = Astro.props;

/** Grouped by month so the archive reads like a journal rather than a feed. */
const groups = posts.reduce<{ key: string; label: string; posts: BlogPost[] }[]>((acc, post) => {
  const year = post.data.date.getFullYear();
  const month = String(post.data.date.getMonth() + 1).padStart(2, "0");
  const key = `${year}-${month}`;
  const group = acc.find((item) => item.key === key);

  if (group) {
    group.posts.push(post);
  } else {
    acc.push({ key, label: `${year} / ${month}`, posts: [post] });
  }

  return acc;
}, []);

const formatDay = (date: Date) =>
  `${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
---

<html lang="zh-CN">
  <head>
    <SiteHead title={pageTitle} description={description} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar />
    <main class="site-grid site-grid--page relative z-10 flex-1 text-text-primary">
      <div class="rail rail--start hidden min-w-0 min-[821px]:block">
        <div class="rail__inner">
          <Sidebar musicHydration="desktop" />
        </div>
      </div>

      <div class="min-w-0">
        <header class="border-b border-border pb-8">
          <p class="label">{eyebrow}</p>
          <h1 class="heading mt-4 text-3xl font-semibold leading-tight sm:text-4xl">{title}</h1>
          <p class="measure mt-5 text-[0.9375rem] leading-8 text-text-secondary">
            {description}
          </p>
        </header>

        {
          posts.length > 0 ? (
            <div class="grid gap-14 pt-10">
              {groups.map((group) => (
                <section aria-label={group.label}>
                  <div class="flex items-baseline justify-between gap-4 border-b border-border pb-2">
                    <h2 class="label m-0">{group.label}</h2>
                    <span class="meta">{String(group.posts.length).padStart(2, "0")}</span>
                  </div>

                  <ol class="index-list m-0 list-none p-0">
                    {group.posts.map((post) => (
                      <li>
                        <a
                          class="entry group grid gap-x-5 gap-y-1 sm:grid-cols-[4rem_minmax(0,1fr)]"
                          href={`/blog/${post.id}/`}
                        >
                          <time
                            class="meta pt-1.5 transition-colors group-hover:text-accent"
                            datetime={post.data.date.toISOString()}
                          >
                            {formatDay(post.data.date)}
                          </time>
                          <div class="min-w-0">
                            <h3 class="entry__title">{post.data.title}</h3>
                            <p class="entry__summary max-w-[48ch]">
                              {post.data.description ?? "这篇文章暂无摘要，点击标题阅读全文。"}
                            </p>
                            {post.data.tags.length > 0 && (
                              <p class="m-0 mt-2.5 flex flex-wrap gap-x-3 gap-y-1">
                                {post.data.tags.map((tag) => (
                                  <span class="tag">#{tag}</span>
                                ))}
                              </p>
                            )}
                          </div>
                        </a>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          ) : (
            <section class="pt-12">
              <h2 class="heading m-0 text-lg font-semibold">暂无文章</h2>
              <p class="mt-3 text-sm leading-7 text-text-secondary">
                当前分类下还没有文章，换个入口看看？
              </p>
              <p class="m-0 mt-5">
                <a class="meta u-link hover:text-accent" href="/blog">
                  返回所有文章 →
                </a>
              </p>
            </section>
          )
        }
      </div>

      <div class="rail rail--end hidden min-w-0 min-[821px]:col-start-2 min-[821px]:block min-[1101px]:col-auto">
        <div class="rail__inner">
          <RightAside />
        </div>
      </div>
    </main>

    <SiteFooter />

    <details class="mobile-assist min-[821px]:hidden">
      <summary class="mobile-assist__toggle" aria-label="打开辅助信息">
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M12 5v14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
        </svg>
      </summary>
      <div class="mobile-assist__panel scrollbar-thin">
        <Sidebar musicHydration="mobile" />
        <div class="mt-6 border-t border-border pt-6">
          <RightAside />
        </div>
      </div>
    </details>
  </body>
</html>
