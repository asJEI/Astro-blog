---
import type { AdjacentPosts } from "../../lib/blog";
import { getPostHref } from "../../lib/blog";

interface Props {
  adjacent: AdjacentPosts;
}

const { adjacent } = Astro.props;
const { prev, next } = adjacent;

if (!prev && !next) {
  return null;
}
---

<nav class="measure mt-16 border-t border-border pt-8" aria-label="文章导航">
  <ul class="m-0 grid list-none gap-8 p-0 sm:grid-cols-2">
    {
      prev && (
        <li>
          <a class="group grid gap-2 no-underline" href={getPostHref(prev)}>
            <span class="meta transition-colors group-hover:text-accent">← 上一篇</span>
            <span class="text-sm font-medium leading-7 text-text-secondary transition-colors group-hover:text-accent">
              {prev.data.title}
            </span>
          </a>
        </li>
      )
    }
    {
      next && (
        <li class={prev ? "sm:text-right" : "sm:col-start-2 sm:text-right"}>
          <a class="group grid gap-2 no-underline" href={getPostHref(next)}>
            <span class="meta transition-colors group-hover:text-accent">下一篇 →</span>
            <span class="text-sm font-medium leading-7 text-text-secondary transition-colors group-hover:text-accent">
              {next.data.title}
            </span>
          </a>
        </li>
      )
    }
  </ul>
</nav>
