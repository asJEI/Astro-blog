---
import heroImage from "../../assets/hero-background.png";
import mobileHeroImage from "../../assets/mobile-hero-background.png";

const links = [
  { label: "阅读文章", href: "/blog" },
  { label: "关于我", href: "/about" },
  { label: "GitHub", href: "https://github.com/asJEI", external: true },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div
    class="hero__image hero__image--desktop"
    style={`background-image: url("${heroImage.src}")`}
    aria-hidden="true"
  >
  </div>
  <div
    class="hero__image hero__image--mobile"
    style={`background-image: url("${mobileHeroImage.src}")`}
    aria-hidden="true"
  >
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__fade" aria-hidden="true"></div>

  <div class="hero__body">
    <p class="hero__eyebrow">Hokkai — Personal Notebook</p>

    <h1 id="hero-title" class="hero__name">北海</h1>

    <p class="hero__motto">北海虽赊，扶摇可接</p>

    <p class="hero__tagline">记录生活，分享思考，探索技术的无限可能</p>

    <nav class="hero__links" aria-label="快速入口">
      {
        links.map((link) => (
          <a
            class="hero__link"
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <a class="hero__scroll" href="#main-content" aria-label="向下查看内容">
    <span class="hero__scroll-line" aria-hidden="true"></span>
    <span class="hero__scroll-chevron" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    align-items: center;
    overflow: hidden;
    background: var(--color-background-dark);
    color: white;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    scale: 1.02;
  }

  .hero__image--mobile {
    display: none;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(6 9 16 / 0.72) 0%,
      rgb(6 9 16 / 0.48) 30%,
      rgb(6 9 16 / 0.16) 62%,
      transparent 100%
    );
  }

  /* Dissolves the photograph into the page surface below it. */
  .hero__fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 32vh;
    background: linear-gradient(
      180deg,
      rgb(244 245 248 / 0) 0%,
      rgb(244 245 248 / 0.3) 66%,
      var(--color-background) 100%
    );
  }

  :global(.dark) .hero__fade {
    background: linear-gradient(
      180deg,
      rgb(11 14 21 / 0) 0%,
      rgb(11 14 21 / 0.36) 70%,
      var(--color-background-dark) 100%
    );
  }

  .hero__body {
    position: relative;
    z-index: 10;
    width: min(calc(100% - 2.5rem), 1240px);
    margin-inline: auto;
    padding-block: 7rem 6rem;
    animation: hero-enter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__eyebrow {
    margin: 0 0 1.75rem;
    color: rgb(255 255 255 / 0.58);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  /*
   * CJK glyphs are already full-width squares — they want a little air at
   * display sizes, not the negative tracking Latin display type asks for.
   */
  .hero__name {
    margin: 0;
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    text-indent: 0.06em;
  }

  .hero__motto {
    margin: 1.5rem 0 0;
    color: rgb(255 255 255 / 0.9);
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.14em;
  }

  .hero__tagline {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: 0.02em;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    margin-top: 2.75rem;
    gap: 1.75rem;
  }

  .hero__link {
    position: relative;
    padding-bottom: 0.45rem;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero__link::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    opacity: 0.3;
    content: "";
    transition: opacity 0.2s ease;
  }

  .hero__link:hover {
    color: white;
  }

  .hero__link:hover::after {
    opacity: 1;
  }

  .hero__scroll {
    position: absolute;
    bottom: max(2rem, env(safe-area-inset-bottom));
    left: 50%;
    z-index: 20;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    /* It lands inside the fade, where the photo has become the page surface. */
    color: var(--color-text-muted);
    text-decoration: none;
    translate: -50% 0;
    transition: color 0.2s ease, translate 0.2s ease;
  }

  .hero__scroll:hover {
    color: var(--color-text-primary);
    translate: -50% 0.2rem;
  }

  .hero__scroll-line {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(180deg, transparent, currentColor);
  }

  .hero__scroll-chevron {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    margin-top: -0.25rem;
    rotate: 45deg;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      translate: 0 1.25rem;
    }
  }

  @media (max-width: 720px) {
    .hero {
      align-items: flex-end;
    }

    .hero__image--desktop {
      display: none;
    }

    .hero__image--mobile {
      display: block;
    }

    /*
     * The mobile artwork is a near-white wall, so light text needs a much
     * heavier scrim than the desktop crop — anchored at the bottom.
     */
    .hero__scrim {
      background: linear-gradient(
        180deg,
        rgb(6 9 16 / 0.16) 0%,
        rgb(6 9 16 / 0.08) 32%,
        rgb(6 9 16 / 0.74) 70%,
        rgb(6 9 16 / 0.93) 100%
      );
    }

    .hero__fade {
      height: 16vh;
      background: linear-gradient(180deg, rgb(6 9 16 / 0) 0%, var(--color-background) 100%);
    }

    :global(.dark) .hero__fade {
      background: linear-gradient(180deg, rgb(6 9 16 / 0) 0%, var(--color-background-dark) 100%);
    }

    .hero__body {
      width: min(calc(100% - 2rem), 1240px);
      padding-block: 0 22vh;
    }

    .hero__eyebrow {
      margin-bottom: 1.25rem;
      letter-spacing: 0.22em;
    }

    .hero__motto {
      margin-top: 1rem;
    }

    .hero__tagline {
      margin-top: 0.9rem;
      font-size: 0.875rem;
      line-height: 1.85;
    }

    .hero__links {
      margin-top: 2rem;
      gap: 1.25rem;
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__body {
      animation: none;
    }
  }
</style>
