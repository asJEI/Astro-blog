---
import heroImage from "../../assets/hero-background.png";
import mobileHeroImage from "../../assets/mobile-hero-background.png";
import HeroAtmosphere from "./HeroAtmosphere.astro";

const links = [
  { label: "开始阅读 ↗", href: "#main-content", external: false, primary: true },
  { label: "关于我", href: "/about", external: false, primary: false },
];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div
    class="hero__image hero__image--desktop"
    data-hero-parallax
    style={`background-image: url("${heroImage.src}")`}
    aria-hidden="true"
  >
  </div>
  <div
    class="hero__image hero__image--mobile"
    style={`background-image: url("${mobileHeroImage.src}")`}
    aria-hidden="true"
  >
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <HeroAtmosphere />
  <div class="hero__fade" aria-hidden="true"></div>

  <div class="hero__body">
    <div data-hero-enter="title">
      <p class="hero__eyebrow">HOKKAI / A LIFE IN PROGRESS</p>
      <h1 id="hero-title" class="hero__name">北海<span class="hero__edition">未完成时</span></h1>
    </div>

    <div data-hero-enter="copy">
      <p class="hero__motto">北海虽赊，扶摇可接</p>
      <p class="hero__tagline">在这里，记录我如何理解世界，<br />也记录世界如何改变我。</p>
    </div>

    <nav class="hero__links" data-hero-enter="links" aria-label="快速入口">
      {
        links.map((link) => (
          <a
            class:list={["hero__link", { "hero__link--primary": link.primary }]}
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noreferrer" } : {})}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <a class="hero__scroll" href="#main-content" aria-label="向下查看内容">
    <span class="hero__scroll-line" aria-hidden="true"></span>
    <span class="hero__scroll-chevron" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 82svh;
    align-items: center;
    overflow: hidden;
    background: var(--color-background-dark);
    color: white;
  }

  .hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;
    background-position: center;
    background-size: cover;
    /* Crop margin so the desktop drift never exposes an edge. */
    scale: 1.06;
  }

  .hero__image--mobile {
    display: none;
  }

  .hero__scrim {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(6 9 16 / 0.72) 0%,
      rgb(6 9 16 / 0.48) 30%,
      rgb(6 9 16 / 0.16) 62%,
      transparent 100%
    );
  }

  /* Dissolves the photograph into the page surface below it. */
  .hero__fade {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: 0;
    height: 32vh;
    background: linear-gradient(
      180deg,
      rgb(246 244 239 / 0) 0%,
      rgb(246 244 239 / 0.3) 66%,
      var(--color-background) 100%
    );
  }

  :global(.dark) .hero__fade {
    background: linear-gradient(
      180deg,
      rgb(11 14 21 / 0) 0%,
      rgb(11 14 21 / 0.36) 70%,
      var(--color-background-dark) 100%
    );
  }

  .hero__body {
    position: relative;
    z-index: 10;
    width: min(calc(100% - 5rem), 1120px);
    margin-inline: auto;
    padding-block: 7rem 6rem;
  }

  .hero__eyebrow {
    margin: 0 0 1.75rem;
    color: rgb(255 255 255 / 0.58);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  /*
   * CJK glyphs are already full-width squares — they want a little air at
   * display sizes, not the negative tracking Latin display type asks for.
   */
  .hero__name {
    margin: 0;
    font-size: clamp(4rem, 12vw, 8.5rem);
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.06em;
    text-indent: 0.06em;
  }

  .hero__motto {
    margin: 1.5rem 0 0;
    color: rgb(255 255 255 / 0.9);
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.14em;
  }

  .hero__edition {
    display: inline-block;
    margin-left: 1.4rem;
    padding-left: 1rem;
    border-left: 1px solid rgb(255 255 255 / 0.45);
    font-size: 0.85rem;
    line-height: 1.9;
    letter-spacing: 0.25em;
    writing-mode: vertical-rl;
    vertical-align: middle;
  }

  .hero__tagline {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    color: rgb(255 255 255 / 0.7);
    font-size: 0.9375rem;
    line-height: 1.9;
    letter-spacing: 0.02em;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    margin-top: 2.75rem;
    gap: 1.75rem;
  }

  .hero__link {
    position: relative;
    padding-bottom: 0.45rem;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero__link::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    content: "";
    opacity: 0.35;
    transform: scaleX(0.28);
    transform-origin: left center;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms ease;
  }

  .hero__link:is(:hover, :focus-visible) {
    color: white;
  }

  .hero__link:is(:hover, :focus-visible)::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .hero__scroll {
    position: absolute;
    bottom: max(2rem, env(safe-area-inset-bottom));
    left: 50%;
    z-index: 20;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    /* It lands inside the fade, where the photo has become the page surface. */
    color: var(--color-text-muted);
    text-decoration: none;
    translate: -50% 0;
    transition: color 0.2s ease, translate 0.2s ease;
  }

  .hero__scroll:hover {
    color: var(--color-text-primary);
    translate: -50% 0.2rem;
  }

  .hero__scroll-line {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(180deg, transparent, currentColor);
  }

  .hero__scroll-chevron {
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    margin-top: -0.25rem;
    rotate: 45deg;
  }

  /*
   * Phones stack the artwork above the words: the window and its figure get
   * the top of the screen to themselves, and the type sits on the page
   * surface below instead of fighting a near-white wall.
   */
  @media (max-width: 720px) {
    .hero {
      --hero-stage: clamp(21rem, 58svh, 34rem);

      display: block;
      min-height: 0;
      background: transparent;
      color: var(--color-text-primary);
    }

    .hero__image--desktop {
      display: none;
    }

    /* Framed so the window, birds and seal all stay inside the stage. */
    .hero__image--mobile {
      display: block;
      inset: 0 0 auto;
      height: var(--hero-stage);
      background-position: center 16%;
      scale: 1;
    }

    .hero__scrim {
      inset: 0 0 auto;
      height: var(--hero-stage);
      background: linear-gradient(180deg, rgb(246 244 239 / 0.45) 0%, rgb(246 244 239 / 0) 22%);
    }

    :global(.dark) .hero__image--mobile {
      filter: brightness(0.58) saturate(0.85);
    }

    :global(.dark) .hero__scrim {
      background: linear-gradient(180deg, rgb(6 9 16 / 0.5) 0%, rgb(6 9 16 / 0) 26%);
    }

    .hero__fade {
      top: calc(var(--hero-stage) * 0.55);
      bottom: auto;
      height: calc(var(--hero-stage) * 0.45 + 1px);
      background: linear-gradient(
        180deg,
        rgb(246 244 239 / 0) 0%,
        color-mix(in srgb, var(--color-background) 72%, transparent) 55%,
        var(--color-background) 100%
      );
    }

    :global(.dark) .hero__fade {
      background: linear-gradient(
        180deg,
        rgb(17 23 32 / 0) 0%,
        color-mix(in srgb, var(--color-background) 72%, transparent) 55%,
        var(--color-background) 100%
      );
    }

    .hero__body {
      width: calc(100% - 3rem);
      padding-block: calc(var(--hero-stage) - 4.25rem) 1rem;
    }

    .hero__eyebrow {
      margin-bottom: 1rem;
      color: var(--color-text-muted);
      font-size: 0.625rem;
      letter-spacing: 0.22em;
    }

    .hero__name {
      font-size: clamp(3.5rem, 18vw, 4.5rem);
    }

    .hero__edition {
      margin-left: 1rem;
      padding-left: 0.75rem;
      border-left-color: var(--color-border);
      color: var(--color-text-secondary);
      font-size: 0.75rem;
    }

    .hero__motto {
      margin-top: 1rem;
      color: var(--color-text-primary);
      font-size: 1.125rem;
    }

    .hero__tagline {
      margin-top: 0.6rem;
      color: var(--color-text-secondary);
      font-size: 0.875rem;
      line-height: 1.85;
    }

    .hero__links {
      align-items: center;
      margin-top: 1.75rem;
      gap: 0.5rem 1.5rem;
    }

    .hero__link {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      padding-bottom: 0;
      color: var(--color-text-secondary);
      -webkit-tap-highlight-color: transparent;
    }

    .hero__link::after {
      bottom: 0.6rem;
    }

    .hero__link--primary {
      padding-inline: 1.35rem;
      border-radius: 999px;
      background: var(--color-text-primary);
      color: var(--color-background);
      transition: background-color 0.2s ease, scale 0.15s ease;
    }

    .hero__link--primary::after {
      display: none;
    }

    .hero__link--primary:is(:hover, :focus-visible) {
      color: var(--color-background);
    }

    .hero__link:not(.hero__link--primary):is(:hover, :focus-visible) {
      color: var(--color-text-primary);
    }

    .hero__link:active {
      scale: 0.97;
    }

    .hero__scroll {
      display: none;
    }
  }

</style>
