---
import { getCollection, getEntry } from "astro:content";

const featuredPostIds = ["vibe-coding-guide", "attention"];
const fallbackSummary = "这篇文章暂无摘要，点击标题阅读全文。";

const featuredProjects = (
  await Promise.all(featuredPostIds.map((id) => getEntry("blog", id)))
)
  .filter((post) => post && !post.data.draft)
  .map((post) => ({
    title: post.data.title,
    href: `/blog/${post.id}/`,
    summary: post.data.description ?? fallbackSummary,
    tags: post.data.tags,
  }));

const latestArticles = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map((post) => ({
    title: post.data.title,
    date: post.data.date,
    href: `/blog/${post.id}/`,
    tags: post.data.tags,
    summary: post.data.description ?? fallbackSummary,
  }));

const formatDate = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(
    date.getDate(),
  ).padStart(2, "0")}`;
---

<div class="grid min-w-0 gap-16 text-text-primary">
  <section aria-labelledby="featured-projects-title">
    <header class="flex items-baseline justify-between gap-4 border-b border-border pb-3">
      <h2 id="featured-projects-title" class="heading m-0 text-base font-semibold tracking-[0.18em]">
        精选
      </h2>
      <span class="label">Selected</span>
    </header>

    <ol class="index-list m-0 list-none p-0">
      {
        featuredProjects.map((project, index) => (
          <li>
            <a class="entry group grid gap-x-5 gap-y-2 sm:grid-cols-[2.75rem_minmax(0,1fr)]" href={project.href}>
              <span class="meta pt-1.5 transition-colors group-hover:text-accent">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <h3 class="entry__title heading text-xl">{project.title}</h3>
                <p class="entry__summary max-w-[46ch]">{project.summary}</p>
                {project.tags.length > 0 && (
                  <p class="m-0 mt-3 flex flex-wrap gap-x-3 gap-y-1">
                    {project.tags.map((tag) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="latest-articles-title">
    <header class="flex items-baseline justify-between gap-4 border-b border-border pb-3">
      <h2 id="latest-articles-title" class="heading m-0 text-base font-semibold tracking-[0.18em]">
        最新
      </h2>
      <span class="label">Recent</span>
    </header>

    <ol class="index-list m-0 list-none p-0">
      {
        latestArticles.map((article) => (
          <li>
            <a class="entry group grid gap-x-5 gap-y-1 sm:grid-cols-[6rem_minmax(0,1fr)]" href={article.href}>
              <time
                class="meta pt-1.5 transition-colors group-hover:text-accent"
                datetime={article.date.toISOString()}
              >
                {formatDate(article.date)}
              </time>
              <div class="min-w-0">
                <h3 class="entry__title">{article.title}</h3>
                <p class="entry__summary max-w-[48ch]">{article.summary}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="m-0 border-t border-border pt-5">
      <a class="meta u-link hover:text-accent" href="/blog">查看全部文章 →</a>
    </p>
  </section>
</div>
