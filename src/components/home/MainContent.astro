---
import { getCollection } from "astro:content";
import { categories, categoryIds } from "../../lib/categories";
import Sidebar from "../layout/Sidebar.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = posts.find((post) => post.id === "fine-tuning") ?? posts[0];
const perspectives = ["我走过的地方", "我内心的变化", "我对世界的理解"];
const formatDate = (date: Date) => `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---
<div class="notebook">
  <section class="opening-note" data-reveal aria-labelledby="welcome-title">
    <div class="section-caption"><span>01 / 初次见面</span><span>A NOTE TO YOU</span></div>
    <div class="opening-note__grid">
      <div>
        <p class="note-kicker">写给偶然走到这里的你</p>
        <h2 id="welcome-title">人始终可以，<br />再成为自己一点。</h2>
        <p class="opening-note__text">这里有关于技术的探索，也有一些难以归类的心事。<br class="desktop-break" />把它们写下来，留给未来，也留给此刻的你。</p>
        <a class="text-link" href="/about">认识北海 <span aria-hidden="true">↗</span></a>
      </div>
      {featured && <a class="first-reading" href={`/blog/${featured.id}/`}>
        <span class="bookmark" aria-hidden="true"></span>
        <span class="note-kicker">如果只读一篇</span>
        <h3>{featured.data.title}</h3>
        <p>从过去留下的权重，到参与改变自己的可能。</p>
        <div class="first-reading__foot"><time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time><span>翻开这一页 ↗</span></div>
      </a>}
    </div>
  </section>
  <section class="perspectives" aria-labelledby="perspectives-title">
    <div class="section-caption"><h2 id="perspectives-title">02 / 三个方向，同一个我</h2><span>WAYS OF SEEING</span></div>
    <div class="perspectives__grid">
      {categoryIds.map((id, index) => {
        const category = categories[id];
        const selected = posts.find((post) => post.id === category.featuredSlug) ?? posts.find((post) => post.data.category === id);
        return <article class={`perspective perspective--${id}`} data-reveal style={index ? `--reveal-delay: ${index * 50}ms` : undefined}>
          <a class="perspective__heading" href={category.href}><span class="perspective__mark" aria-hidden="true">{["↗", "◌", "⌁"][index]}</span><div><h3>{category.label}</h3><p>{perspectives[index]}</p></div><span class="perspective__arrow" aria-hidden="true">↗</span></a>
          {selected && <a class="perspective__article" href={`/blog/${selected.id}/`}>{selected.data.title}<span>从这里读起 →</span></a>}
        </article>;
      })}
    </div>
  </section>
  <div class="notebook__lower">
    <section aria-labelledby="recent-title" data-reveal>
      <div class="section-caption"><h2 id="recent-title">03 / 最近写下</h2><a href="/blog">全部文章 ↗</a></div>
      <ol class="recent-pages">
        {posts.slice(0, 6).map((post) => <li><a class="recent-page" href={`/blog/${post.id}/`}>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
          <div><span class="note-kicker">{post.data.category ? categories[post.data.category].label : "手记"}</span><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="recent-page__arrow" aria-hidden="true">↗</span>
        </a></li>)}
      </ol>
      <a class="archive-link" href="/blog">回到某个时候 <span>浏览时间归档 ↗</span></a>
    </section>
    <aside class="desk" aria-labelledby="desk-title">
      <div class="section-caption"><h2 id="desk-title">桌边</h2><span>AT MY DESK</span></div>
      <Sidebar musicHydration="all" />
      <div class="desk__note"><span class="note-kicker">留在这里的一句话</span><p>博客会迁移，框架会迭代。<br />真正一直在更新的，<br />应该是屏幕前的自己。</p><a class="text-link" href="/blog/rethink-blog/">关于这个空间 ↗</a></div>
    </aside>
  </div>
  <section class="work-note" data-reveal aria-labelledby="work-title">
    <div><p class="note-kicker">从想法，到现实 / SELECTED WORK</p><h2 id="work-title">也动手做一些东西。</h2><p>把问题拆开，把想法做出来，再到真实世界里寻找反馈。</p></div>
    <a class="work-note__link" href="/portfolio">看看我的作品 <span aria-hidden="true">↗</span></a>
  </section>
</div>
