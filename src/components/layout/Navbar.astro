---
import { getCollection } from "astro:content";

import siteIcon from "../../assets/site-icon.png";
import { sortPostsByDateDesc } from "../../lib/blog";

interface Props {
  /** Home lays the bar over the hero photograph until the reader scrolls past it. */
  overlay?: boolean;
  /** Pages that never scroll (the embedded portfolio) need a permanent surface. */
  solid?: boolean;
}

const { overlay = false, solid = false } = Astro.props;

const navItems = [
  { label: "首页", href: "/" },
  { label: "所有文章", href: "/blog" },
  { label: "技术", href: "/blog/tech" },
  { label: "生活", href: "/blog/life" },
  { label: "幽微", href: "/blog/moments" },
  { label: "关于", href: "/about" },
  { label: "作品集", href: "/portfolio" },
];

const categoryPaths = ["/blog/tech", "/blog/life", "/blog/moments"];
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href === "/blog") {
    return (
      currentPath === "/blog" ||
      (currentPath.startsWith("/blog/") && !categoryPaths.includes(currentPath))
    );
  }
  return currentPath === href;
};

const searchPosts = sortPostsByDateDesc(
  await getCollection("blog", ({ data }) => !data.draft),
).map((post) => ({
  title: post.data.title,
  description: post.data.description ?? "",
  tags: post.data.tags,
  href: `/blog/${post.id}/`,
}));
---

<header
  class="navbar"
  data-navbar
  data-overlay={String(overlay)}
  data-solid={solid ? "true" : undefined}
  data-scrolled={solid ? "" : undefined}
>
  <div class="navbar__inner">
    <a class="navbar__brand" href="/" aria-label="北海首页">
      <img src={siteIcon.src} alt="" width="26" height="26" />
      <span>北海</span>
    </a>

    <nav class="navbar__links" aria-label="主导航">
      {
        navItems.map((item) => (
          <a class="navbar__link" href={item.href} data-active={isActive(item.href) ? "true" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="navbar__actions">
      <div class="navbar__search" data-search-root>
        <button class="navbar__icon" type="button" aria-label="搜索文章" data-search-toggle>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.7"
            />
          </svg>
        </button>

        <div class="search-panel" data-search-panel>
          <div class="search-panel__box">
            <label class="sr-only" for="site-search-input">搜索文章</label>
            <div class="search-panel__field">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.7"
                />
              </svg>
              <input
                id="site-search-input"
                type="search"
                placeholder="搜索标题、摘要或标签"
                autocomplete="off"
                data-search-input
              />
              <kbd>Esc</kbd>
            </div>
            <div class="search-panel__results scrollbar-thin" data-search-results>
              <p class="search-panel__empty">按 / 唤起搜索，输入关键词开始。</p>
            </div>
          </div>
        </div>
      </div>

      <button class="navbar__icon" type="button" aria-label="切换深色模式" data-theme-toggle>
        <svg class="navbar__icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
          />
        </svg>
        <svg class="navbar__icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20.3 14.4A7.8 7.8 0 0 1 9.6 3.7 8.8 8.8 0 1 0 20.3 14.4Z"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
          />
        </svg>
      </button>

      <a class="navbar__icon" href="https://github.com/asJEI" target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.93.85.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.92c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.06.36.32.68.95.68 1.92v2.8c0 .28.18.6.69.5A10.17 10.17 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
            fill="currentColor"
          />
        </svg>
      </a>

      <button
        class="navbar__icon navbar__icon--menu"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="navbar__mobile" data-mobile-menu>
    <nav class="navbar__mobile-inner" aria-label="移动导航">
      {
        navItems.map((item) => (
          <a
            class="navbar__mobile-link"
            href={item.href}
            data-active={isActive(item.href) ? "true" : undefined}
            data-mobile-menu-link
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .navbar {
    --nav-fg: var(--color-text-secondary);
    --nav-fg-strong: var(--color-text-primary);

    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    color: var(--nav-fg);
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
  }

  .navbar[data-scrolled] {
    border-bottom-color: var(--color-border);
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  /* Over the hero photograph the bar is pure type on the image. */
  .navbar[data-overlay="true"]:not([data-scrolled]) {
    --nav-fg: rgb(255 255 255 / 0.72);
    --nav-fg-strong: rgb(255 255 255);
  }

  .navbar__inner {
    display: flex;
    min-height: var(--nav-height);
    width: min(calc(100% - 2.5rem), 1240px);
    align-items: center;
    gap: 1.5rem;
    margin-inline: auto;
  }

  .navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--nav-fg-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .navbar__brand img {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .navbar__links {
    display: none;
    flex: 1;
    align-items: center;
    gap: 1.5rem;
  }

  .navbar__link {
    position: relative;
    padding-block: 0.35rem;
    color: var(--nav-fg);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .navbar__link::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    content: "";
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar__link:hover {
    color: var(--nav-fg-strong);
  }

  .navbar__link:hover::after {
    scale: 1 1;
  }

  .navbar__link[data-active] {
    color: var(--nav-fg-strong);
  }

  .navbar__link[data-active]::after {
    background: var(--color-accent);
    scale: 1 1;
  }

  .navbar[data-overlay="true"]:not([data-scrolled]) .navbar__link[data-active]::after {
    background: currentColor;
  }

  .navbar__actions {
    display: flex;
    margin-left: auto;
    align-items: center;
    gap: 0.25rem;
  }

  .navbar__icon {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--nav-fg);
    cursor: pointer;
    touch-action: manipulation;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .navbar__icon:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
    color: var(--nav-fg-strong);
  }

  .navbar__icon svg {
    width: 1rem;
    height: 1rem;
  }

  .navbar__icon-moon,
  :global(.dark) .navbar__icon-sun {
    display: none;
  }

  :global(.dark) .navbar__icon-moon {
    display: block;
  }

  /* ------------------------------------------------------------- search */

  .navbar__search {
    position: relative;
  }

  .search-panel {
    position: fixed;
    inset-inline: 1rem;
    top: calc(var(--nav-height) + 0.5rem);
    display: none;
    opacity: 0;
    translate: 0 -0.35rem;
    transition: opacity 0.2s ease, translate 0.2s ease;
  }

  .search-panel[data-open] {
    display: block;
    opacity: 1;
    translate: 0 0;
  }

  .search-panel__box {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    box-shadow: 0 1.25rem 3.5rem rgb(11 14 21 / 0.18);
    color: var(--color-text-primary);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .search-panel__field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid var(--color-border);
    padding-inline: 0.9rem;
  }

  .search-panel__field svg {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .search-panel__field input {
    min-width: 0;
    height: 2.75rem;
    flex: 1;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 0.875rem;
    outline: none;
  }

  .search-panel__field input::placeholder {
    color: var(--color-text-muted);
  }

  .search-panel__field kbd {
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .search-panel__results {
    display: grid;
    max-height: min(22rem, calc(100vh - 9rem));
    overflow-y: auto;
    padding: 0.4rem;
  }

  .search-panel__empty {
    margin: 0;
    padding: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  /* ------------------------------------------------------- mobile menu */

  .navbar__mobile {
    display: none;
    border-top: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .navbar__mobile[data-open] {
    display: block;
  }

  .navbar__mobile-inner {
    display: grid;
    width: min(calc(100% - 2rem), 1240px);
    margin-inline: auto;
    padding-block: 0.5rem 1rem;
  }

  .navbar__mobile-link {
    border-bottom: 1px solid var(--color-border);
    padding-block: 0.85rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .navbar__mobile-link:last-child {
    border-bottom: 0;
  }

  .navbar__mobile-link[data-active] {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .navbar__inner {
      width: min(calc(100% - 2rem), 1240px);
    }
  }

  @media (min-width: 900px) {
    .navbar__links {
      display: flex;
    }

    .navbar__icon--menu {
      display: none;
    }

    .search-panel {
      position: absolute;
      inset-inline: auto 0;
      top: calc(100% + 0.6rem);
      width: min(24rem, calc(100vw - 3rem));
    }
  }
</style>

<style is:global>
  .search-result {
    display: grid;
    gap: 0.2rem;
    border-radius: 5px;
    padding: 0.55rem 0.75rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .search-result:hover,
  .search-result:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .search-result__title {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .search-result__meta {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.71875rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>

<script define:vars={{ searchPosts }}>
  window.__blogSearchPosts = searchPosts;

  if (!window.__navbarBound) {
    window.__navbarBound = true;

    const q = (selector) => document.querySelector(selector);

    const escapeHtml = (value) =>
      value.replace(
        /[&<>"']/g,
        (char) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char],
      );

    const setMenuOpen = (isOpen) => {
      const menu = q("[data-mobile-menu]");
      const toggle = q("[data-mobile-menu-toggle]");
      menu?.toggleAttribute("data-open", isOpen);
      toggle?.setAttribute("aria-expanded", String(isOpen));
    };

    const setSearchOpen = (isOpen) => {
      const panel = q("[data-search-panel]");
      panel?.toggleAttribute("data-open", isOpen);

      if (isOpen) {
        setMenuOpen(false);
        requestAnimationFrame(() => q("[data-search-input]")?.focus());
      }
    };

    const renderResults = (query) => {
      const results = q("[data-search-results]");
      if (!results) return;

      const keyword = query.trim().toLowerCase();

      if (!keyword) {
        results.innerHTML =
          '<p class="search-panel__empty">按 / 唤起搜索，输入关键词开始。</p>';
        return;
      }

      const matches = (window.__blogSearchPosts ?? [])
        .filter((post) =>
          [post.title, post.description, ...post.tags].join(" ").toLowerCase().includes(keyword),
        )
        .slice(0, 8);

      if (matches.length === 0) {
        results.innerHTML = '<p class="search-panel__empty">没有找到相关文章。</p>';
        return;
      }

      results.innerHTML = matches
        .map(
          (post) => `
            <a class="search-result" href="${post.href}">
              <span class="search-result__title">${escapeHtml(post.title)}</span>
              <span class="search-result__meta">${escapeHtml(
                post.description || post.tags.map((tag) => `#${tag}`).join("  "),
              )}</span>
            </a>`,
        )
        .join("");
    };

    const syncScrolled = () => {
      const navbar = q("[data-navbar]");
      if (!navbar || navbar.dataset.solid === "true") return;

      const threshold =
        navbar.dataset.overlay === "true" ? window.innerHeight * 0.7 : 8;
      navbar.toggleAttribute("data-scrolled", window.scrollY > threshold);
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("[data-search-toggle]")) {
        setSearchOpen(!q("[data-search-panel]")?.hasAttribute("data-open"));
        return;
      }

      if (target.closest("[data-mobile-menu-toggle]")) {
        setMenuOpen(!q("[data-mobile-menu]")?.hasAttribute("data-open"));
        return;
      }

      if (target.closest("[data-mobile-menu-link]")) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("input", (event) => {
      if (event.target instanceof HTMLInputElement && event.target.matches("[data-search-input]")) {
        renderResults(event.target.value);
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (!target.closest("[data-search-root]")) setSearchOpen(false);
      if (!target.closest("[data-navbar]")) setMenuOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setSearchOpen(false);
        setMenuOpen(false);
        return;
      }

      const inField =
        event.target instanceof HTMLElement &&
        (event.target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(event.target.tagName));

      if (inField) return;

      if (event.key === "/" || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
        event.preventDefault();
        setSearchOpen(true);
      }
    });

    window.addEventListener("scroll", syncScrolled, { passive: true });
    window.addEventListener("resize", syncScrolled);
    document.addEventListener("astro:page-load", syncScrolled);
    syncScrolled();
  }
</script>
