---
import { getCollection } from "astro:content";

import siteIcon from "../../assets/site-icon.png";
import { sortPostsByDateDesc } from "../../lib/blog";
import { categories, categoryIds } from "../../lib/categories";

interface Props {
  /** Home lays the bar over the hero photograph until the reader scrolls past it. */
  overlay?: boolean;
  /** Pages that never scroll (the embedded portfolio) need a permanent surface. */
  solid?: boolean;
}

const { overlay = false, solid = false } = Astro.props;

const navItems = [
  { label: "首页", href: "/" },
  { label: "文章", href: "/blog" },
  { label: "关于", href: "/about" },
  { label: "作品集", href: "/portfolio" },
];

const categoryPaths = categoryIds.map((id) => categories[id].href.replace(/\/+$/, ""));
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) => {
  href = href.replace(/\/+$/, "") || "/";
  if (href === "/") return currentPath === "/";
  if (href === "/blog") {
    return (
      currentPath === "/blog" ||
      (currentPath.startsWith("/blog/") && !categoryPaths.includes(currentPath))
    );
  }
  return currentPath === href;
};

const drawerCategories = categoryIds.map((id) => categories[id]);

const searchPosts = sortPostsByDateDesc(
  await getCollection("blog", ({ data }) => !data.draft),
).map((post) => ({
  title: post.data.title,
  description: post.data.description ?? "",
  tags: post.data.tags,
  category: post.data.category ?? "archive",
  categoryLabel: post.data.category ? categories[post.data.category].label : "Archive",
  href: `/blog/${post.id}/`,
}));
---

<header
  class="navbar"
  transition:name="site-nav"
  transition:animate="none"
  data-navbar
  data-overlay={String(overlay)}
  data-solid={solid ? "true" : undefined}
  data-scrolled={solid ? "" : undefined}
>
  <div class="navbar__inner">
    <a class="navbar__brand" href="/" aria-label="北海首页">
      <img src={siteIcon.src} alt="" width="26" height="26" />
      <span>北海 <small class="brand-edition">/ 未完成时</small></span>
    </a>

    <nav class="navbar__links" aria-label="主导航">
      {
        navItems.map((item) => (
          <a class="navbar__link" href={item.href} data-active={isActive(item.href) ? "true" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="navbar__actions">
      <div class="navbar__search" data-search-root>
        <button class="navbar__icon" type="button" aria-label="搜索文章" aria-expanded="false" aria-controls="site-search-panel" data-search-toggle>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.7"
            />
          </svg>
        </button>

        <div id="site-search-panel" class="search-panel" data-search-panel>
          <div class="search-panel__box">
            <label class="sr-only" for="site-search-input">搜索文章</label>
            <div class="search-panel__field">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="m21 21-4.35-4.35m1.35-5.65a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.7"
                />
              </svg>
              <input
                id="site-search-input"
                type="search"
                placeholder="搜索标题、摘要或标签"
                autocomplete="off"
                enterkeyhint="search"
                data-search-input
              />
              <kbd>Esc</kbd>
              <button class="search-panel__cancel" type="button" data-search-close>取消</button>
            </div>
            <div class="search-panel__results scrollbar-thin" aria-live="polite" data-search-results></div>
          </div>
        </div>
      </div>

      <button class="navbar__icon navbar__icon--wide" type="button" aria-label="切换深色模式" data-theme-toggle>
        <svg class="navbar__icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 4V2m0 20v-2m8-8h2M2 12h2m13.66-5.66 1.41-1.41M4.93 19.07l1.41-1.41m0-11.32L4.93 4.93m14.14 14.14-1.41-1.41M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
          />
        </svg>
        <svg class="navbar__icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20.3 14.4A7.8 7.8 0 0 1 9.6 3.7 8.8 8.8 0 1 0 20.3 14.4Z"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
          />
        </svg>
      </button>

      <a class="navbar__icon navbar__icon--wide" href="https://github.com/asJEI" target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.5v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.36 1.12 2.93.85.09-.66.35-1.12.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.92c.85 0 1.7.12 2.5.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.06.36.32.68.95.68 1.92v2.8c0 .28.18.6.69.5A10.17 10.17 0 0 0 22 12.24C22 6.58 17.52 2 12 2Z"
            fill="currentColor"
          />
        </svg>
      </a>

      <button
        class="navbar__icon navbar__icon--menu"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path class="navbar__menu-line navbar__menu-line--top" d="M4 8h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
          <path class="navbar__menu-line navbar__menu-line--bottom" d="M4 16h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Outside the header: its backdrop-filter would otherwise trap this fixed layer. -->
<div id="mobile-menu" class="drawer" data-mobile-menu>
  <nav class="drawer__inner" aria-label="移动导航">
    <div class="drawer__nav">
      {
        navItems.map((item, index) => (
          <a
            class="drawer__link"
            href={item.href}
            style={`--drawer-index: ${index}`}
            aria-current={isActive(item.href) ? "page" : undefined}
            data-mobile-menu-link
          >
            <span class="drawer__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="drawer__section" style={`--drawer-index: ${navItems.length}`}>
      <p class="drawer__caption">三个方向</p>
      <div class="drawer__chips">
        {
          drawerCategories.map((category) => (
            <a class="drawer__chip" href={category.href} data-mobile-menu-link>
              {category.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="drawer__foot" style={`--drawer-index: ${navItems.length + 1}`}>
      <div class="drawer__tools">
        <button class="drawer__tool" type="button" data-theme-toggle>
          <span class="drawer__tool-light">深色模式</span>
          <span class="drawer__tool-dark">浅色模式</span>
        </button>
        <button class="drawer__tool drawer__tool--motion" type="button" data-motion-toggle aria-pressed="true">
          动态 <span class="drawer__motion-on">开</span><span class="drawer__motion-off">关</span><span class="drawer__motion-system">已遵循系统</span>
        </button>
        <a class="drawer__tool" href="https://github.com/asJEI" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
      <p class="drawer__motto">北海虽赊，扶摇可接</p>
    </div>
  </nav>
</div>

<style>
  .navbar {
    --nav-fg: var(--color-text-secondary);
    --nav-fg-strong: var(--color-text-primary);

    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    color: var(--nav-fg);
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
  }

  .navbar[data-scrolled] {
    border-bottom-color: var(--color-border);
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  /* Over the hero photograph the bar is pure type on the image. */
  .navbar[data-overlay="true"]:not([data-scrolled]) {
    --nav-fg: rgb(255 255 255 / 0.72);
    --nav-fg-strong: rgb(255 255 255);
  }

  .navbar__inner {
    display: flex;
    min-height: var(--nav-height);
    width: min(calc(100% - 5rem), 1120px);
    align-items: center;
    gap: 1.5rem;
    margin-inline: auto;
  }

  .navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--nav-fg-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .navbar__brand img {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .navbar__links {
    display: none;
    flex: 1;
    align-items: center;
    gap: 1.5rem;
  }

  .navbar__link {
    position: relative;
    padding-block: 0.35rem;
    color: var(--nav-fg);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .navbar__link::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    content: "";
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .navbar__link:hover {
    color: var(--nav-fg-strong);
  }

  .navbar__link:hover::after {
    scale: 1 1;
  }

  .navbar__link[data-active] {
    color: var(--nav-fg-strong);
  }

  .navbar__link[data-active]::after {
    background: var(--color-accent);
    scale: 1 1;
  }

  .navbar[data-overlay="true"]:not([data-scrolled]) .navbar__link[data-active]::after {
    background: currentColor;
  }

  .navbar__actions {
    display: flex;
    margin-left: auto;
    align-items: center;
    gap: 0.25rem;
  }

  .navbar__icon {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--nav-fg);
    cursor: pointer;
    touch-action: manipulation;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .navbar__icon:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
    color: var(--nav-fg-strong);
  }

  .navbar__icon svg {
    width: 1rem;
    height: 1rem;
  }

  .navbar__icon-moon,
  :global(.dark) .navbar__icon-sun {
    display: none;
  }

  :global(.dark) .navbar__icon-moon {
    display: block;
  }

  /* ------------------------------------------------------------- search */

  .navbar__search {
    position: relative;
  }

  .search-panel {
    position: fixed;
    inset-inline: 1rem;
    top: calc(var(--nav-height) + 0.5rem);
    display: none;
    opacity: 0;
    translate: 0 -0.35rem;
    transition: opacity 0.2s ease, translate 0.2s ease;
  }

  .search-panel[data-open] {
    display: block;
    opacity: 1;
    translate: 0 0;
  }

  .search-panel__box {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    box-shadow: 0 1.25rem 3.5rem rgb(11 14 21 / 0.18);
    color: var(--color-text-primary);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .search-panel__field {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-bottom: 1px solid var(--color-border);
    padding-inline: 0.9rem;
  }

  .search-panel__field svg {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .search-panel__field input {
    min-width: 0;
    height: 2.75rem;
    flex: 1;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 0.875rem;
    outline: none;
  }

  .search-panel__field input::placeholder {
    color: var(--color-text-muted);
  }

  .search-panel__field kbd {
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .search-panel__results {
    display: grid;
    max-height: min(22rem, calc(100vh - 9rem));
    overflow-y: auto;
    padding: 0.4rem;
  }

  .search-panel__cancel {
    display: none;
  }

  /* ------------------------------------------------------- menu drawer */

  .navbar__menu-line {
    transform-box: fill-box;
    transform-origin: center;
    transition: translate 0.25s cubic-bezier(0.22, 1, 0.36, 1), rotate 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .navbar[data-menu-open] .navbar__menu-line--top {
    translate: 0 4px;
    rotate: 45deg;
  }

  .navbar[data-menu-open] .navbar__menu-line--bottom {
    translate: 0 -4px;
    rotate: -45deg;
  }

  /* While the drawer is open the bar sits on it as a plain surface. */
  .navbar[data-menu-open] {
    --nav-fg: var(--color-text-secondary);
    --nav-fg-strong: var(--color-text-primary);

    border-bottom-color: transparent;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 49;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-background);
    background-image: var(--grain);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0s linear 0.25s;
  }

  .drawer[data-open] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease, visibility 0s;
  }

  .drawer__inner {
    display: flex;
    min-height: 100%;
    width: calc(100% - 3rem);
    flex-direction: column;
    margin-inline: auto;
    padding-block: calc(var(--nav-height) + 1.5rem) max(1.75rem, env(safe-area-inset-bottom));
  }

  .drawer__nav,
  .drawer__section,
  .drawer__foot {
    opacity: 0;
    translate: 0 0.6rem;
    transition: opacity 0.35s ease, translate 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--drawer-index, 0) * 40ms);
  }

  .drawer__nav {
    display: grid;
  }

  .drawer[data-open] :is(.drawer__nav, .drawer__section, .drawer__foot) {
    opacity: 1;
    translate: 0 0;
  }

  .drawer__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-block: 1.05rem;
    color: var(--color-text-primary);
    font-family: var(--font-serif);
    font-size: 1.625rem;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.2s ease;
  }

  .drawer__link:active {
    color: var(--color-accent);
  }

  .drawer__index {
    width: 1.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .drawer__link[aria-current="page"] {
    color: var(--color-accent);
  }

  .drawer__link[aria-current="page"] .drawer__index {
    color: inherit;
  }

  .drawer__section {
    margin-top: 2.25rem;
  }

  .drawer__caption {
    margin: 0 0 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
  }

  .drawer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .drawer__chip {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding-inline: 1.15rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .drawer__chip:active {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .drawer__foot {
    margin-top: auto;
    padding-top: 2.5rem;
  }

  .drawer__tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--color-border);
  }

  .drawer__tool {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    border: 0;
    background: transparent;
    color: var(--color-text-secondary);
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .drawer__tool + .drawer__tool {
    border-left: 1px solid var(--color-border);
  }

  .drawer__tool:active {
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .drawer__tool-dark,
  :global(.dark) .drawer__tool-light,
  .drawer__motion-on,
  .drawer__motion-off,
  .drawer__motion-system {
    display: none;
  }

  :global(.dark) .drawer__tool-dark,
  :global(html:not([data-motion-active])) .drawer__motion-on,
  :global(html[data-motion-active="on"]) .drawer__motion-on,
  :global(html[data-motion-active="still"]:not([data-motion-system="reduce"])) .drawer__motion-off,
  :global(html[data-motion-system="reduce"]) .drawer__motion-system {
    display: inline;
  }

  .drawer__motion-on,
  .drawer__motion-off {
    color: var(--color-accent);
  }

  .drawer__motto {
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    letter-spacing: 0.24em;
    text-align: center;
  }

  @media (max-width: 899px) {
    .navbar__icon--wide {
      display: none;
    }

    .navbar__icon {
      width: 2.75rem;
      height: 2.75rem;
    }

    .navbar__icon svg {
      width: 1.125rem;
      height: 1.125rem;
    }

    .navbar__actions {
      margin-right: -0.6rem;
    }
  }

  @media (max-width: 640px) {
    .navbar__inner {
      width: min(calc(100% - 2rem), 1240px);
    }
  }

  @media (max-width: 379px) {
    .brand-edition {
      display: none;
    }
  }

  /* The phone hero is a pale wall, so the bar inks itself dark over it. */
  @media (max-width: 720px) {
    :global(html:not(.dark)) .navbar[data-overlay="true"]:not([data-scrolled]) {
      --nav-fg: rgb(23 28 38 / 0.72);
      --nav-fg-strong: #171c26;
    }

    .search-panel {
      inset: 0 auto auto 0;
      width: 100vw;
      height: 100dvh;
      background: var(--color-background);
      translate: 0 0;
    }

    .search-panel[data-open] {
      display: flex;
    }

    .search-panel__box {
      display: flex;
      width: 100%;
      flex-direction: column;
      border: 0;
      border-radius: 0;
      background: var(--color-background);
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .search-panel__field {
      min-height: var(--nav-height);
      padding: env(safe-area-inset-top) 0 0 1.25rem;
    }

    .search-panel__field input {
      height: var(--nav-height);
      font-size: 1rem;
    }

    .search-panel__field kbd {
      display: none;
    }

    .search-panel__cancel {
      display: inline-flex;
      height: var(--nav-height);
      align-items: center;
      border: 0;
      background: transparent;
      padding: 0 1.25rem;
      color: var(--color-accent);
      font: inherit;
      font-size: 0.9375rem;
      cursor: pointer;
    }

    .search-panel__results {
      max-height: none;
      flex: 1;
      overscroll-behavior: contain;
      padding: 0.5rem 0.75rem max(1rem, env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 900px) {
    .navbar__links {
      display: flex;
    }

    .navbar__icon--menu,
    .drawer {
      display: none;
    }

    .search-panel {
      position: absolute;
      inset-inline: auto 0;
      top: calc(100% + 0.6rem);
      width: min(24rem, calc(100vw - 3rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer__nav,
    .drawer__section,
    .drawer__foot {
      translate: 0 0;
    }
  }
</style>

<style is:global>
  html[data-scroll-lock] {
    overflow: hidden;
  }

  .search-panel__empty {
    margin: 0;
    padding: 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .search-panel__caption {
    margin: 0.35rem 0 0.25rem;
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }

  @media (hover: none) {
    .search-panel__hint {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .search-result {
      padding: 0.85rem 0.75rem;
    }

    .search-result__title {
      font-size: 0.9375rem;
    }

    .search-result__meta {
      font-size: 0.78125rem;
    }
  }

  .search-result {
    display: grid;
    gap: 0.2rem;
    border-radius: 5px;
    padding: 0.55rem 0.75rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .search-result:hover,
  .search-result:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
  }

  .search-result__title {
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .search-result__meta {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.71875rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>

<script define:vars={{ searchPosts }}>
  window.__blogSearchPosts = searchPosts;

  if (!window.__navbarBound) {
    window.__navbarBound = true;

    const q = (selector) => document.querySelector(selector);

    const escapeHtml = (value) =>
      value.replace(
        /[&<>"']/g,
        (char) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char],
      );

    const phoneQuery = window.matchMedia("(max-width: 720px)");

    const syncScrollLock = () => {
      const menuOpen = q("[data-mobile-menu]")?.hasAttribute("data-open");
      const searchFull = phoneQuery.matches && q("[data-search-panel]")?.hasAttribute("data-open");
      document.documentElement.toggleAttribute("data-scroll-lock", Boolean(menuOpen || searchFull));
    };

    const setMenuOpen = (isOpen) => {
      const menu = q("[data-mobile-menu]");
      const toggle = q("[data-mobile-menu-toggle]");
      menu?.toggleAttribute("data-open", isOpen);
      q("[data-navbar]")?.toggleAttribute("data-menu-open", isOpen);
      toggle?.setAttribute("aria-expanded", String(isOpen));
      toggle?.setAttribute("aria-label", isOpen ? "关闭导航菜单" : "打开导航菜单");
      syncScrollLock();
    };

    const renderPostLinks = (posts) =>
      posts
        .map(
          (post) => `
            <a class="search-result" href="${post.href}">
              <span class="search-result__title">${escapeHtml(post.title)}</span>
              <span class="search-result__meta">${escapeHtml(
                post.description || post.tags.map((tag) => `#${tag}`).join("  "),
              )}</span>
            </a>`,
        )
        .join("");

    const renderEmpty = () =>
      '<p class="search-panel__empty search-panel__hint">按 / 唤起搜索，输入关键词开始。</p>' +
      '<p class="search-panel__caption">最近写下</p>' +
      renderPostLinks((window.__blogSearchPosts ?? []).slice(0, 5));

    const setSearchOpen = (isOpen) => {
      const panel = q("[data-search-panel]");
      if (isOpen && panel && !panel.hasAttribute("data-open")) {
        const input = q("[data-search-input]");
        renderResults(input?.value ?? "");
      }
      panel?.toggleAttribute("data-open", isOpen);
      q("[data-search-toggle]")?.setAttribute("aria-expanded", String(isOpen));

      if (isOpen) {
        setMenuOpen(false);
        requestAnimationFrame(() => q("[data-search-input]")?.focus());
      }
      syncScrollLock();
    };

    const renderResults = (query) => {
      const results = q("[data-search-results]");
      if (!results) return;

      const keyword = query.trim().toLowerCase();

      if (!keyword) {
        results.innerHTML = renderEmpty();
        return;
      }

      const matches = (window.__blogSearchPosts ?? [])
        .filter((post) =>
          [post.title, post.description, post.category, post.categoryLabel, ...post.tags].join(" ").toLowerCase().includes(keyword),
        )
        .slice(0, 8);

      if (matches.length === 0) {
        results.innerHTML = '<p class="search-panel__empty">没有找到相关文章。</p>';
        return;
      }

      results.innerHTML = renderPostLinks(matches);
    };

    const syncScrolled = () => {
      const navbar = q("[data-navbar]");
      if (!navbar || navbar.dataset.solid === "true") return;

      // On phones the hero text scrolls straight under the bar, so it needs a surface early.
      const threshold =
        navbar.dataset.overlay === "true" && !phoneQuery.matches
          ? Math.max(8, (q(".hero")?.getBoundingClientRect().height ?? window.innerHeight) - 100)
          : 8;
      navbar.toggleAttribute("data-scrolled", window.scrollY > threshold);
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest("[data-search-toggle]")) {
        setSearchOpen(!q("[data-search-panel]")?.hasAttribute("data-open"));
        return;
      }

      if (target.closest("[data-search-close]")) {
        setSearchOpen(false);
        return;
      }

      if (target.closest("[data-mobile-menu-toggle]")) {
        setMenuOpen(!q("[data-mobile-menu]")?.hasAttribute("data-open"));
        return;
      }

      if (target.closest("[data-mobile-menu-link]")) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("input", (event) => {
      if (event.target instanceof HTMLInputElement && event.target.matches("[data-search-input]")) {
        renderResults(event.target.value);
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (!target.closest("[data-search-root]") && q("[data-search-panel]")?.hasAttribute("data-open")) {
        setSearchOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        const searchWasOpen = q("[data-search-panel]")?.hasAttribute("data-open");
        setSearchOpen(false);
        setMenuOpen(false);
        if (searchWasOpen) q("[data-search-toggle]")?.focus();
        return;
      }

      const inField =
        event.target instanceof HTMLElement &&
        (event.target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(event.target.tagName));

      if (inField) return;

      if (event.key === "/" || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k")) {
        event.preventDefault();
        setSearchOpen(true);
      }
    });

    window.addEventListener("scroll", syncScrolled, { passive: true });
    window.addEventListener("resize", syncScrolled);
    phoneQuery.addEventListener("change", syncScrollLock);
    document.addEventListener("astro:before-swap", () => document.documentElement.removeAttribute("data-scroll-lock"));
    document.addEventListener("astro:page-load", syncScrolled);
    syncScrolled();
  }
</script>
