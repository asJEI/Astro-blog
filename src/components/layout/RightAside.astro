---
import { getCollection } from "astro:content";

import { sortPostsByDateDesc } from "../../lib/blog";

const posts = sortPostsByDateDesc(await getCollection("blog", ({ data }) => !data.draft));
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
  a.localeCompare(b, "zh-CN"),
);
const siteStartYear =
  posts.length > 0
    ? String(Math.min(...posts.map((post) => post.data.date.getFullYear())))
    : String(new Date().getFullYear());

const siteStats = [
  { label: "文章", value: String(posts.length) },
  { label: "标签", value: String(tags.length) },
  { label: "始于", value: siteStartYear },
];

const recentUpdates = posts.slice(0, 3).map((post) => ({
  title: post.data.title,
  href: `/blog/${post.id}/`,
  date: post.data.date,
}));

const formatShortDate = (date: Date) =>
  `${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;

const blockClass = "mt-6 border-t border-border pt-6";
---

<aside class="w-full text-text-primary" aria-label="网站辅助信息">
  <section aria-labelledby="site-info-title">
    <h2 id="site-info-title" class="label label--cjk">档案</h2>
    <dl class="m-0 mt-3 grid gap-2">
      {
        siteStats.map((stat) => (
          <div class="flex items-baseline justify-between gap-3">
            <dt class="meta">{stat.label}</dt>
            <dd class="m-0 font-mono text-sm tabular-nums text-text-secondary">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class={blockClass} aria-labelledby="tag-cloud-title">
    <h2 id="tag-cloud-title" class="label label--cjk">主题</h2>
    {
      tags.length > 0 ? (
        <ul class="m-0 mt-3 flex list-none flex-wrap gap-x-2 gap-y-1.5 p-0">
          {tags.map((tag) => (
            <li class="meta text-text-secondary">{tag}</li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm leading-6 text-text-secondary">暂无标签</p>
      )
    }
  </section>

  <section class={blockClass} aria-labelledby="recent-updates-title">
    <h2 id="recent-updates-title" class="label label--cjk">近期</h2>
    {
      recentUpdates.length > 0 ? (
        <ul class="m-0 mt-3 grid list-none gap-3 p-0">
          {recentUpdates.map((item) => (
            <li class="grid gap-1">
              <span class="meta">{formatShortDate(item.date)}</span>
              <a
                class="text-sm leading-6 text-text-secondary no-underline transition-colors hover:text-accent"
                href={item.href}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-3 text-sm leading-6 text-text-secondary">暂无动态</p>
      )
    }
  </section>
</aside>
