---
import avatar from "../../assets/sidebar-avatar.png";
import MusicPlayer from "../sidebar/MusicPlayer";

interface Props {
  musicHydration?: "all" | "desktop" | "mobile" | "none";
}

const { musicHydration = "all" } = Astro.props;

const skills = ["AI", "LLM", "Agent", "计算机", "二次元", "动漫", "游戏"];

const socialLinks = [
  { label: "GitHub", handle: "asJEI", href: "https://github.com/asJEI" },
  { label: "X", handle: "BeiHai_Hokkai", href: "https://x.com/BeiHai_Hokkai" },
];

const blockClass = "mt-6 border-t border-border pt-6";
---

<aside class="w-full text-text-primary" aria-label="个人信息侧边栏">
  <section aria-labelledby="profile-title">
    <img
      class="h-16 w-16 rounded-card object-cover grayscale-[0.15] transition duration-500 hover:grayscale-0"
      src={avatar.src}
      alt="北海的头像"
      width="64"
      height="64"
    />
    <h2 id="profile-title" class="heading mt-4 text-lg font-semibold leading-tight">北海</h2>
    <p class="mt-2 text-sm leading-6 text-text-secondary">一个普通的大三学生罢了</p>
  </section>

  <section class={blockClass} aria-labelledby="skills-title">
    <h3 id="skills-title" class="label label--cjk">标签</h3>
    <ul class="m-0 mt-3 flex list-none flex-wrap gap-x-2 gap-y-1.5 p-0">
      {
        skills.map((skill) => (
          <li class="meta text-text-secondary">{skill}</li>
        ))
      }
    </ul>
  </section>

  <section class={blockClass} data-sidebar-music aria-labelledby="music-player-title">
    <h3 id="music-player-title" class="sr-only">音乐播放器</h3>
    {musicHydration === "all" && (
      <MusicPlayer client:load transition:persist="beihai-music-player" transition:persist-props />
    )}
    {musicHydration === "desktop" && (
      <MusicPlayer
        client:media="(min-width: 821px)"
        transition:persist="beihai-music-player"
        transition:persist-props
      />
    )}
    {musicHydration === "mobile" && <MusicPlayer client:media="(max-width: 820px)" />}
  </section>

  <section class={blockClass} aria-labelledby="social-title">
    <h3 id="social-title" class="label label--cjk">别处</h3>
    <ul class="m-0 mt-3 grid list-none gap-2 p-0">
      {
        socialLinks.map((link) => (
          <li>
            <a
              class="group flex items-baseline justify-between gap-3 text-sm no-underline"
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              <span class="u-link font-medium text-text-secondary transition-colors group-hover:text-accent">
                {link.label}
              </span>
              <span class="meta shrink-0 truncate">{link.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</aside>
