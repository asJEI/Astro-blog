---
import { ClientRouter } from "astro:transitions";
---

<ClientRouter />

<script is:inline>
  (function () {
    var root = document.documentElement;
    try {
      var storedTheme = localStorage.getItem("theme");
      var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
        root.classList.add("dark");
      }
    } catch (e) {}

    var reduce = false;
    var motion = null;
    try {
      reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      motion = localStorage.getItem("beihai-motion");
    } catch (e) {}

    var still = reduce || motion === "off";
    root.dataset.motion = motion === "off" ? "off" : "on";
    root.dataset.motionActive = still ? "still" : "on";
    if (reduce) root.dataset.motionSystem = "reduce";

    var path = location.pathname.replace(/\/+$/, "") || "/";
    if (path !== "/") return;

    var entrance = still ? "none" : "full";
    if (!still) {
      try {
        if (sessionStorage.getItem("beihai-hero-seen") === "1") entrance = "short";
        else sessionStorage.setItem("beihai-hero-seen", "1");
      } catch (e) {}
    }
    root.dataset.heroEntrance = entrance;
  })();
</script>

<script>
  import { startMotion } from "../../lib/motion";

  startMotion();

  const applyTheme = () => {
    let storedTheme: string | null = null;
    try { storedTheme = localStorage.getItem("theme"); } catch { /* System theme remains available. */ }
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;

    document.documentElement.classList.toggle(
      "dark",
      storedTheme === "dark" || (!storedTheme && prefersDark),
    );
  };

  applyTheme();
  document.addEventListener("astro:page-load", applyTheme);

  const cleanupOrphanedMusicPlayers = () => {
    const players = document.querySelectorAll('[aria-label="音乐播放器"]');

    players.forEach((player) => {
      if (player.closest('aside[aria-label="个人信息侧边栏"]')) {
        return;
      }

      player.closest("section")?.remove();
    });
  };

  cleanupOrphanedMusicPlayers();
  document.addEventListener("astro:page-load", cleanupOrphanedMusicPlayers);

  document.addEventListener("click", (event) => {
    const toggle = event.target instanceof Element ? event.target.closest("[data-theme-toggle]") : null;
    if (!toggle) {
      return;
    }

    const isDark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch { /* Theme still works for this page. */ }
  });
</script>
