---
import "../styles/global.css";

import Resume from "../components/about/Resume.astro";
import Navbar from "../components/layout/Navbar.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHead from "../components/layout/SiteHead.astro";

const pageDate = new Date("2026-06-28");

const formatDate = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(
    date.getDate(),
  ).padStart(2, "0")}`;

const epigraph = "我始终相信，技术不是终点，而是一种观察世界的方式。";

const creed = [
  "从神经网络到软件工程，从 AI 应用到个人项目，我尝试把学习过程中每一次思考、每一次实践都沉淀下来。这里没有刻意追逐热点，更多的是记录那些值得反复推敲的原理、值得长期打磨的作品，以及那些在探索过程中不断修正的认知。",
  "这个博客记录我的学习、项目、思考与表达。这里既有代码，也有文字；既有技术，也有认知；既有解决问题的方法，也有对问题本身的追问。如果说程序让计算机理解世界，那么写作，则让我理解自己。",
  "希望未来回望时，这些文字能够成为自己成长的轨迹；如果也能给路过的人带来一点启发，那便足够了。",
];

const sections = [
  {
    id: "site",
    heading: "本站背景",
    body: "本站是基于 Astro 框架进行搭建，并且通过本地编辑的方式。将整个项目仓库存储在 GitHub 上接着使用 Cloudflare Pages 进行部署的个人博客。本站最初是使用云服务器 + Wordpress 进行搭建，可惜迫于服务器成本压力最后选择了更加实惠的 Astro。",
  },
  {
    id: "intro",
    heading: "本站介绍",
    body: "本站主要是用来记录我的一些日常生活和在计算机领域的学习经验，我并不会开通评论或者留言等功能，但是文末会贴出我的邮箱以及联系方式，如果想要和我交个朋友的话可以联系我 QwQ。",
  },
  {
    id: "author",
    heading: "作者介绍",
    body: "INTP，我可能更多地喜欢活跃在互联网上，线下有些社恐不过接触多了之后就没有那么内向了。此外性别男，年龄 21，目前大三马上就要大四。计科专业学生，学校的话只是一个普通的双非本科。暂时没有考公考研的打算，目前正在实习秋招中。",
  },
  {
    id: "hobby",
    heading: "关于爱好",
    body: "应该算是二次元？不过更多只是单纯的看动漫或者听一些术曲，对于所谓的圈子了解并不多。娱乐方面的话电脑游戏玩的比较多，比如我的世界、饥荒、泰拉瑞亚这些沙盒游戏之外，肉鸽类的以撒的结合、杀戮尖塔也都有玩，除此之外还有 FPS 类的 APEX、绝地潜兵这些。我自认为我是一个情绪很稳定的人，所以我并不介意给我发邮件，如果我看到了也都会回复的。",
  },
];

const contacts = [
  { label: "Email", value: "316920080dd@gmail.com", href: "mailto:316920080dd@gmail.com" },
  { label: "Email", value: "316920080@qq.com", href: "mailto:316920080@qq.com" },
  { label: "QQ", value: "316920080" },
];
---

<html lang="zh-CN">
  <head>
    <SiteHead
      title="关于"
      description="关于北海：一个计科专业学生的博客、履历与联系方式。"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Navbar />

    <main class="site-grid site-grid--page relative z-10 flex-1 text-text-primary">
      <div class="rail rail--start hidden min-w-0 min-[821px]:block">
        <div class="rail__inner">
          <Sidebar musicHydration="desktop" />
        </div>
      </div>

      <div class="min-w-0">
        <article>
          <header class="measure border-b border-border pb-8">
            <p class="label">About</p>
            <h1 class="heading mt-4 text-3xl font-semibold leading-tight sm:text-4xl">关于</h1>
            <time class="meta mt-5 block" datetime={pageDate.toISOString()}>
              更新于 {formatDate(pageDate)}
            </time>
          </header>

          <section class="measure py-12" aria-label="自述">
            <p class="m-0 font-serif text-xl leading-[1.9] tracking-[0.04em] text-text-primary sm:text-[1.375rem]">
              {epigraph}
            </p>
            <div class="mt-7 grid gap-5">
              {
                creed.map((paragraph) => (
                  <p class="m-0 text-[0.9375rem] leading-8 text-text-secondary">{paragraph}</p>
                ))
              }
            </div>
          </section>

          <div class="article-content border-t border-border pt-4">
            {
              sections.map((section) => (
                <section>
                  <h2 id={section.id}>{section.heading}</h2>
                  <p>{section.body}</p>
                </section>
              ))
            }

            <section>
              <h2 id="contact">联系方式</h2>
              <dl class="m-0 mt-6 grid gap-3">
                {
                  contacts.map((contact) => (
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                      <dt class="label w-16 shrink-0">{contact.label}</dt>
                      <dd class="m-0 font-mono text-sm">
                        {contact.href ? (
                          <a href={contact.href}>{contact.value}</a>
                        ) : (
                          contact.value
                        )}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </section>

            <section>
              <h2 id="resume">简历</h2>
              <Resume />
            </section>
          </div>
        </article>
      </div>

      <div class="rail rail--end hidden min-w-0 min-[821px]:col-start-2 min-[821px]:block min-[1101px]:col-auto">
        <div class="rail__inner">
          <nav class="w-full" aria-labelledby="about-toc-title">
            <h2 id="about-toc-title" class="label label--cjk">本页</h2>
            <ol class="m-0 mt-4 grid list-none gap-2 p-0">
              {
                [...sections, { id: "contact", heading: "联系方式" }, { id: "resume", heading: "简历" }].map(
                  (section) => (
                    <li>
                      <a
                        class="text-[0.8125rem] leading-6 text-text-muted no-underline transition-colors hover:text-accent"
                        href={`#${section.id}`}
                      >
                        {section.heading}
                      </a>
                    </li>
                  ),
                )
              }
            </ol>
          </nav>
        </div>
      </div>
    </main>

    <SiteFooter />

    <details class="mobile-assist min-[821px]:hidden">
      <summary class="mobile-assist__toggle" aria-label="打开辅助信息">
        <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M12 5v14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.6" />
        </svg>
      </summary>
      <div class="mobile-assist__panel scrollbar-thin">
        <Sidebar musicHydration="mobile" />
      </div>
    </details>
  </body>
</html>
