---
import "../styles/global.css";
import Hero from "../components/home/Hero.astro";
import MainContent from "../components/home/MainContent.astro";
import Navbar from "../components/layout/Navbar.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHead from "../components/layout/SiteHead.astro";
import { site } from "../lib/seo";
---
<html lang="zh-CN">
  <head><SiteHead title="北海 · 未完成时" description={site.defaultDescription} /></head>
  <body class="flex min-h-screen flex-col">
    <Navbar overlay />
    <Hero />
    <main id="main-content" class="home-shell" transition:name="page" transition:animate="fade"><MainContent /></main>
    <SiteFooter />
  </body>
</html>
